{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/quest",
      "destination": "https://www.oculus.com/open_url/?url=https%3A%2F%2Fshadowfolk.vercel.app%2F",
      "permanent": false
    },
    {
      "source": "/video",
      "destination": "https://youtu.be/HJrWuZwFKZw",
      "permanent": false
    }
  ]
}
